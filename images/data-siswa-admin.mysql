INSERT INTO `program` VALUES (2,1,'Kitabah','bahasa-arab-dasar','Program pembelajaran \"Bahasa Arab Dasar\" dirancang bertahap agar mudah diikuti pemula.','programs/fwJFBqBYk6gnvsPO8BXAQxuNq2LeCm3s1yt44Es1.jpg',NULL,'Ust. Ahmad Fauzan','pemula',3,0,100000.00,'aktif',0,0,NULL,'2026-08-08 20:40:51','2026-08-10 22:15:24'),(3,1,'Fahmul Masmu','nahwu-pemula','Program pembelajaran \"Nahwu Pemula\" dirancang bertahap agar mudah diikuti pemula.','programs/KRSYdng1vpt0uyqzXza8W4CMs1JCvXEXlYUQ2PVH.jpg',NULL,'Ust. Hasan Ali','pemula',2,0,150000.00,'aktif',0,1,NULL,'2026-08-08 20:40:51','2026-08-10 22:10:38'),(4,1,'Bahasa Arab Dasar','sharaf-dasar','Program pembelajaran \"Sharaf Dasar\" dirancang bertahap agar mudah diikuti pemula.','programs/Fc5OOSxmbFCdO0TqSd9dzy5CjoedqcS531HGbAM6.jpg',NULL,'Ust. Hasan Ali','menengah',2,0,650000.00,'aktif',0,2,NULL,'2026-08-08 20:40:51','2026-08-10 22:16:27'),(5,1,'Qiroah & Masmu','muhadatsah','Program pembelajaran \"Muhadatsah\" dirancang bertahap agar mudah diikuti pemula.','programs/kQhTNTslfPbz3DNb12eWgWRk1NB2YQKwCUx9zt3g.jpg',NULL,'Ust. Abdurrahman','menengah',1,0,250000.00,'aktif',0,3,NULL,'2026-08-08 20:40:51','2026-08-10 22:19:18'),(6,2,'Tahsin Tilawah','tahsin-tilawah','Program pembelajaran \"Tahsin Tilawah\" dirancang bertahap agar mudah diikuti pemula.','programs/jXBmTKx342EUWHiIkMzNfB8nZ6l6Bma8Fh6fdzZ0.jpg',NULL,'Ust. Bakri','pemula',2,0,150000.00,'aktif',0,4,NULL,'2026-08-08 20:40:51','2026-08-10 22:22:29'),(20,NULL,'Program Pesantren Mahasiswa (6 Bulan) (Offline)','program-pesantren-mahasiswa-6-bulan-offline','Program pembinaan terpadu yang menggabungkan pendidikan agama, pembelajaran bahasa Arab, pembentukan karakter, serta pembiasaan ibadah dan kehidupan disiplin di lingkungan pesantren.','programs/aSqJ62FELzLlAn4ZTC892kbxYLoBJIz5YYb8kR54.jpg',NULL,NULL,'pemula',3,2,4500000.00,'aktif',1,5,NULL,'2026-08-09 13:00:40','2026-08-11 06:01:15');
