INSERT INTO `programs` VALUES (1,'Bahasa Arab Intensif','bahasa-arab-intensif','Senin â€“ Jumat','3 Bulan','Program pembelajaran Bahasa Arab dasar hingga menengah dengan metode interaktif dan praktik harian.',NULL,1,1,'2026-08-08 20:40:50','2026-08-08 20:40:50'),(2,'Tahfidzul Quran','tahfidzul-quran','Setiap Hari','2 Tahun','Hafalan Al-Quran dengan bimbingan hafizh bersanad, setoran rutin, dan evaluasi pekanan.',NULL,1,2,'2026-08-08 20:40:50','2026-08-08 20:40:50'),(3,'Mahad & Hunian Santri','mahad-hunian-santri','24 Jam','Tahunan','Hunian mahasiswa yang nyaman dalam lingkungan islami, dekat dengan kampus dan fasilitas umum.',NULL,1,3,'2026-08-08 20:40:50','2026-08-08 20:40:50'),(4,'Kelas Malam (BA)','kelas-malam-ba','Senin â€“ Kamis','6 Bulan','Kelas Bahasa Arab malam untuk mahasiswa dan umum yang memiliki aktivitas di siang hari.',NULL,1,4,'2026-08-08 20:40:50','2026-08-08 20:40:50'),(5,'Persiapan Beasiswa','persiapan-beasiswa','Sabtu â€“ Ahad','4 Bulan','Program intensif persiapan tes Bahasa Arab untuk beasiswa kampus dalam dan luar negeri.',NULL,1,5,'2026-08-08 20:40:50','2026-08-08 20:40:50'),(6,'Pembinaan Karakter','pembinaan-karakter','Mingguan','Berjalan','Kajian rutin dan pembinaan adab serta akhlak sebagai bekal kehidupan para peserta.',NULL,1,6,'2026-08-08 20:40:50','2026-08-08 20:40:50');
/*!40000 ALTER TABLE `programs` ENABLE KEYS */;
